# Required: copy to .env.local and fill from Supabase Project Settings > API.
# Only the public anon/publishable key belongs here. Never put service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public contact fallbacks used only when database settings are empty.
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
